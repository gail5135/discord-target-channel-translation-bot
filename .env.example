# discord.js 클라이언트 로그인 토큰 (Developer Portal > Bot > Token)
DISCORD_TOKEN=

# 애플리케이션(클라이언트) ID (Developer Portal > General Information > Application ID)
DISCORD_CLIENT_ID=

# 봇을 쓸 서버(길드) ID. 슬래시 커맨드가 이 서버에 등록된다.
# 길드 단위 등록은 즉시 반영된다(글로벌 등록은 최대 1시간). 서버를 늘리려면
# deploy-commands.ts를 글로벌 등록(Routes.applicationCommands)으로 바꿔야 한다.
DISCORD_GUILD_ID=

# 번역 API 키 (Phase 3부터 필요). 우선순위는 deepl -> google로 코드에 고정되어 있다.

# DeepL (https://www.deepl.com/pro-api). 무료 키는 ':fx'로 끝나며,
# 엔드포인트(api-free / api)는 이 접미사로 코드가 자동 판별한다.
DEEPL_API_KEY=

# Google Cloud Translation API v2 키 (https://console.cloud.google.com — Cloud Translation API 활성화 후 발급)
GOOGLE_TRANSLATE_API_KEY=
