{
  "name": "discord-translation-bot",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "deploy-commands": "node dist/deploy-commands.js",
    "test": "node -r ts-node/register --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^16.4.5",
    "typescript": "^5.6.0",
    "ts-node": "^10.9.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0"
  }
}
